{
  "name": "tlv-apartment-finder",
  "version": "1.0.0",
  "private": true,
  "description": "Daily Tel Aviv apartment watcher with WhatsApp alerts for new listings and price drops",
  "type": "commonjs",
  "main": "dist/src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "setup": "npm install && playwright install chromium && prisma generate && prisma db push",
    "browser:install": "playwright install chromium",
    "browser:deps": "playwright install --with-deps chromium",
    "dev": "ts-node src/server.ts",
    "start": "node dist/src/server.js",
    "scan": "ts-node src/cli.ts scan",
    "scan:dry": "ts-node src/cli.ts scan --dry-run",
    "notify:test": "ts-node src/cli.ts notify-test",
    "snapshot:import": "ts-node src/cli.ts snapshot-import",
    "snapshot:export": "ts-node src/cli.ts snapshot-export",
    "site:build": "npm run snapshot:export",
    "test": "node --require ts-node/register --test tests/*.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.3.0",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "node-cron": "^3.0.3",
    "playwright": "^1.56.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "prisma": "^6.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
