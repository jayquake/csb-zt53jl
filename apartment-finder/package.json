{
  "name": "tlv-apartment-finder",
  "version": "1.0.0",
  "private": true,
  "description": "Daily Tel Aviv apartment watcher with WhatsApp alerts for new listings and price drops",
  "type": "commonjs",
  "main": "dist/src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "setup": "npm install && patchright install chrome && prisma generate && prisma db push",
    "browser:install": "patchright install chrome",
    "dev": "ts-node src/server.ts",
    "start": "node dist/src/server.js",
    "web:dev": "vite",
    "web:build": "vite build",
    "scan": "ts-node src/cli.ts scan",
    "scan:dry": "ts-node src/cli.ts scan --dry-run",
    "notify:test": "ts-node src/cli.ts notify-test",
    "snapshot:import": "ts-node src/cli.ts snapshot-import",
    "snapshot:export": "ts-node src/cli.ts snapshot-export",
    "site:build": "npm run web:build && npm run snapshot:export",
    "test": "node --require ts-node/register --test tests/*.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.3.0",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "cheerio": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^1.61.0",
    "node-cron": "^3.0.3",
    "patchright": "^1.61.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.1.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prisma": "^6.3.0",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "vite": "^8.3.5"
  }
}
